<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ShazamIO</RootNamespace>
    <AssemblyName>ShazamIO</AssemblyName>
    <Version>0.8.0</Version>
    <Authors>dotX12</Authors>
    <Description>Recognizes a song from audio bytes using the reverse-engineered Shazam API.</Description>
    <PackageTags>shazam;music;recognize;api;async;identification;audio;fingerprint</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/dotX12/ShazamIO</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="3.1.0" />
    <!-- NAudio 3.x only pulls in Media Foundation for Windows-targeted TFMs; this project is plain net10.0 -->
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <PackageReference Include="Polly" Version="8.8.0" />
    <PackageReference Include="Polly.Extensions.Http" Version="3.0.0" />
  </ItemGroup>

</Project>
