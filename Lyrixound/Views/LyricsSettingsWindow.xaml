<Window x:Class="Lyrixound.Views.LyricsSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Lyrixound.Views"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Lyrixound.ViewModels"
        Title="Lyrics appearance"
        Width="420"
        Height="300"
        d:DataContext="{d:DesignInstance vm:LyricsSettingsViewModel}"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        ShowInTaskbar="False"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d">

    <local:LyricsSettingsView Margin="16,12" DataContext="{Binding}"/>
</Window>
