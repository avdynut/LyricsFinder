<Window x:Class="Lyrixound.Views.PaywallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="530"
        Height="380"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        mc:Ignorable="d">

    <Border Padding="20"
            Background="{DynamicResource MaterialDesignPaper}"
            BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}"
            BorderThickness="2"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15"
                              Opacity="0.5"
                              ShadowDepth="5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Margin="0,0,0,15"
                        Orientation="Horizontal">
                <md:PackIcon Width="32"
                             Height="32"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                             Kind="GuitarAcoustic"/>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"
                           Text="Unlock Lyrixound Pro"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock FontSize="14"
                           Text="Buy Lyrixound Pro to support the author and help keep the app improving."
                           TextWrapping="Wrap"/>
                <TextBlock Margin="0,12,0,0"
                           FontSize="13"
                           Text="• Light and Dark theme"
                           TextWrapping="Wrap"/>
                <TextBlock FontSize="13"
                           Text="• Priority support from the author"
                           TextWrapping="Wrap"/>
                <TextBlock FontSize="13"
                           Text="• One-time purchase - no subscription"
                           TextWrapping="Wrap"/>
                <TextBlock FontSize="13"
                           Text="• Exclusive Pro features coming in future updates (modern UI, etc.)"
                           TextWrapping="Wrap"/>
                <TextBlock FontSize="13"
                           Text="• The main features remain free"
                           TextWrapping="Wrap"/>
                <TextBlock Margin="0,14,0,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="{Binding PriceDisplay}"/>
                <TextBlock Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"/>
                <TextBlock Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           TextWrapping="Wrap"
                           Visibility="{Binding PurchaseCompleted, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Run Text="For priority support, email "/>
                    <Hyperlink Command="{Binding OpenSupportEmailCommand}">
                        <Run Text="{Binding SupportEmail, Mode=OneWay}"/>
                    </Hyperlink>
                    <Run Text="."/>
                </TextBlock>
            </StackPanel>

            <ProgressBar Grid.Row="2"
                         Height="4"
                         Margin="0,0,0,10"
                         IsIndeterminate="True"
                         Visibility="{Binding PurchaseInProgress, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <StackPanel Grid.Row="3"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        Padding="15,8"
                        Command="{Binding MaybeLaterCommand}"
                        Content="MAYBE LATER"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Visibility="{Binding PurchaseCompleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <Button Padding="20,8"
                        Command="{Binding UnlockProCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Visibility="{Binding PurchaseCompleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Width="18"
                                     Height="18"
                                     Margin="0,0,5,0"
                                     Kind="Heart"/>
                        <TextBlock Text="SUPPORT THE AUTHOR"/>
                    </StackPanel>
                </Button>
                <Button Padding="20,8"
                        Command="{Binding CloseCommand}"
                        Content="CLOSE"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Visibility="{Binding PurchaseCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
