<Window x:Class="Lyrixound.Views.PaywallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Width="530"
        Height="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        mc:Ignorable="d">

    <Border Background="{DynamicResource MaterialDesignPaper}"
            BorderBrush="{DynamicResource PrimaryHueMidBrush}"
            BorderThickness="2"
            CornerRadius="10"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15"
                              ShadowDepth="5"
                              Opacity="0.5"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,15">
                <md:PackIcon Width="32"
                             Height="32"
                             Kind="GuitarAcoustic"
                             Foreground="{DynamicResource PrimaryHueMidBrush}"
                             VerticalAlignment="Center"/>
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="Bold"
                           Text="Unlock Lyrixound Pro"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock FontSize="14"
                           Text="Buy Lyrixound Pro to support the author and help keep the app improving."
                           TextWrapping="Wrap"/>
                <TextBlock Margin="0,12,0,0"
                           FontSize="13"
                           Text="• Support continued development"
                           TextWrapping="Wrap"/>
                <TextBlock FontSize="13"
                           Text="• One-time purchase - no subscription"
                           TextWrapping="Wrap"/>
                <TextBlock FontSize="13"
                           Text="• Exclusive Pro features coming in future updates (Light/Dark mode, modern UI, etc.)"
                           TextWrapping="Wrap"/>
                <TextBlock FontSize="13"
                           Text="• The main features remain free"
                           TextWrapping="Wrap"/>
                <TextBlock Margin="0,14,0,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="{Binding PriceDisplay}"/>
                <TextBlock Margin="0,8,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <ProgressBar Grid.Row="2"
                         Height="4"
                         Margin="0,0,0,10"
                         IsIndeterminate="True"
                         Visibility="{Binding PurchaseInProgress, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <StackPanel Grid.Row="3"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        Padding="15,8"
                        Command="{Binding MaybeLaterCommand}"
                        Content="MAYBE LATER"
                        Style="{StaticResource MaterialDesignFlatButton}"/>
                <Button Padding="20,8"
                        Command="{Binding UnlockProCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                    <StackPanel Orientation="Horizontal">
                        <md:PackIcon Width="18"
                                     Height="18"
                                     Margin="0,0,5,0"
                                     Kind="Heart"/>
                        <TextBlock Text="SUPPORT THE AUTHOR"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
