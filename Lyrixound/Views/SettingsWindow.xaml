<Window x:Class="Lyrixound.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:dd="urn:gong-wpf-dragdrop"
        xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:vm="clr-namespace:Lyrixound.ViewModels"
        Width="400"
        Height="360"
        d:DataContext="{d:DesignInstance vm:SettingsWindowViewModel}"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d">

    <Window.Resources>
        <DataTemplate x:Key="CheckIconItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox md:CheckBoxAssist.CheckBoxSize="30" IsChecked="{Binding IsEnabled}">
                    <CheckBox.Content>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="32"
                                   Height="32"
                                   Source="{Binding Name, Converter={StaticResource NameToIconUriConverter}}"/>
                            <TextBlock Margin="4,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Name}"/>
                        </StackPanel>
                    </CheckBox.Content>
                </CheckBox>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding InitializeCommand}"/>
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding ClosingCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <TabControl Padding="10"
                Background="{DynamicResource MaterialDesignPaper}"
                BorderThickness="0">
        <TabControl.ItemContainerStyle>
            <Style TargetType="TabItem">
                <Setter Property="Padding" Value="10"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border Name="TabItem"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{DynamicResource MaterialDesignChipBackground}"
                                    CornerRadius="5,5,0,0">
                                <TextBlock x:Name="Header"
                                           Foreground="{TemplateBinding Foreground}"
                                           Text="{TemplateBinding Header}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabItem" Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TabItem" Property="Background" Value="{DynamicResource MaterialDesignFlatButtonRipple}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </TabControl.ItemContainerStyle>

        <TabItem Header="Main">
            <StackPanel>
                <TextBox md:HintAssist.Hint="Directory"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Text="{Binding LyricsDirectory, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                         ToolTip="Directory to save lyrics files"/>
                <TextBox md:HintAssist.Hint="File Name Pattern"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Text="{Binding FileNamePattern, UpdateSourceTrigger=PropertyChanged, Delay=200}"/>
                <TextBox Grid.Row="0"
                         md:HintAssist.Hint="Check Interval, s"
                         Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                         Text="{Binding CheckInterval, UpdateSourceTrigger=PropertyChanged, Delay=200}"/>
                <CheckBox Margin="0,10"
                          Command="{Binding ChangeRunAtStartupCommand}"
                          Content="Run at startup"
                          IsChecked="{Binding RunAtStartup}"/>
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                    <CheckBox Content="Dark mode"
                              IsChecked="{Binding IsDarkTheme}"/>
                    <TextBlock Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                               Text="Pro"
                               Visibility="{Binding IsPro, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                </StackPanel>
            </StackPanel>
        </TabItem>

        <TabItem Header="Providers">
            <ListBox dd:DragDrop.IsDragSource="True"
                     dd:DragDrop.IsDropTarget="True"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemTemplate="{StaticResource CheckIconItemTemplate}"
                     ItemsSource="{Binding Settings.LyricsProviders}"/>
        </TabItem>

        <TabItem Header="Pro">
            <StackPanel Margin="0,8,0,0">
                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           Text="{Binding ProStatusText}"
                           TextWrapping="Wrap"/>
                <TextBlock Margin="0,8,0,16"
                           FontSize="12"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           Text="Purchase Pro to support the author. Includes priority support and Light/Dark mode. Exclusive Pro features will be added in future updates (modern UI, etc.). The main features remain free."
                           TextWrapping="Wrap"
                           Visibility="{Binding IsPro, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <TextBlock Margin="0,8,0,16"
                           FontSize="12"
                           Foreground="{DynamicResource MaterialDesignBodyLight}"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsPro, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Run Text="For priority support or feedback, email "/>
                    <Hyperlink Command="{Binding OpenSupportEmailCommand}">
                        <Run Text="{Binding SupportEmail, Mode=OneWay}"/>
                    </Hyperlink>
                    <Run Text="."/>
                </TextBlock>
                <Button Margin="0,0,0,8"
                        Padding="12,6"
                        HorizontalAlignment="Left"
                        Command="{Binding UnlockProCommand}"
                        Content="Support the author"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Visibility="{Binding IsPro, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <!--<Button Padding="12,6"
                        HorizontalAlignment="Left"
                        Command="{Binding RestorePurchasesCommand}"
                        Content="Restore purchases"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>-->
                <CheckBox Margin="0,16,0,0"
                          Content="Simulate Pro (Debug only)"
                          IsChecked="{Binding SimulatePro}"
                          Visibility="{Binding CanSimulatePro, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
        </TabItem>

    </TabControl>

</Window>
