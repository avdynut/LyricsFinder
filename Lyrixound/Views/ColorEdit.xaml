<UserControl x:Class="Lyrixound.Views.ColorEdit"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Root"
             d:DesignWidth="160"
             mc:Ignorable="d">
    <UserControl.Resources>
        <DrawingBrush x:Key="CheckerBrush"
                      TileMode="Tile"
                      Viewport="0,0,8,8"
                      ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,8,8"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFBDBDBD">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,4,4"/>
                                <RectangleGeometry Rect="4,4,4,4"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="PresetSwatch" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#808080"
                                BorderThickness="1"
                                CornerRadius="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="SwatchButton"
                    Width="28"
                    Height="28"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Click="OnSwatchClick"
                    Cursor="Hand"
                    ToolTip="Pick a color">
                <Button.Background>
                    <SolidColorBrush Color="{Binding Color, ElementName=Root}"/>
                </Button.Background>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{StaticResource CheckerBrush}"
                                BorderBrush="#808080"
                                BorderThickness="1"
                                CornerRadius="2">
                            <Border Background="{TemplateBinding Background}" CornerRadius="1"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBox x:Name="HexBox"
                     Width="85"
                     VerticalAlignment="Center"
                     md:HintAssist.Hint="{Binding Hint, ElementName=Root}"
                     LostFocus="OnHexLostFocus"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     TextChanged="OnHexChanged"/>
        </StackPanel>

        <Popup x:Name="PickerPopup"
               AllowsTransparency="True"
               Closed="OnPickerClosed"
               Opened="OnPickerOpened"
               Placement="Top"
               PlacementTarget="{Binding ElementName=SwatchButton}"
               StaysOpen="False"
               VerticalOffset="-4">
            <Border Padding="10"
                    Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    CornerRadius="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8"
                                      Opacity="0.35"
                                      ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <UniformGrid Width="180"
                                 Columns="6"
                                 Rows="2">
                        <Button Background="#E6E6FF"
                                Click="OnPresetClick"
                                Style="{StaticResource PresetSwatch}"
                                ToolTip="Default text"/>
                        <Button Background="White"
                                Click="OnPresetClick"
                                Style="{StaticResource PresetSwatch}"
                                ToolTip="White"/>
                        <Button Background="#B0BEC5"
                                Click="OnPresetClick"
                                Style="{StaticResource PresetSwatch}"
                                ToolTip="Gray"/>
                        <Button Background="#212121"
                                Click="OnPresetClick"
                                Style="{StaticResource PresetSwatch}"
                                ToolTip="Soft black"/>
                        <Button Background="Black"
                                Click="OnPresetClick"
                                Style="{StaticResource PresetSwatch}"
                                ToolTip="Black"/>
                        <Button Background="#FFEB3B"
                                Click="OnPresetClick"
                                Style="{StaticResource PresetSwatch}"
                                ToolTip="Yellow"/>
                        <Button Background="#FF9800"
                                Click="OnPresetClick"
                                Style="{StaticResource PresetSwatch}"
                                ToolTip="Orange"/>
                        <Button Background="#FF4081"
                                Click="OnPresetClick"
                                Style="{StaticResource PresetSwatch}"
                                ToolTip="Pink"/>
                        <Button Background="#9C27B0"
                                Click="OnPresetClick"
                                Style="{StaticResource PresetSwatch}"
                                ToolTip="Purple"/>
                        <Button Background="#2196F3"
                                Click="OnPresetClick"
                                Style="{StaticResource PresetSwatch}"
                                ToolTip="Blue"/>
                        <Button Background="#00E5FF"
                                Click="OnPresetClick"
                                Style="{StaticResource PresetSwatch}"
                                ToolTip="Cyan"/>
                        <Button Background="#4CAF50"
                                Click="OnPresetClick"
                                Style="{StaticResource PresetSwatch}"
                                ToolTip="Green"/>
                    </UniformGrid>

                    <Border Margin="0,8,0,8"
                            BorderBrush="#808080"
                            BorderThickness="1">
                        <Grid x:Name="SvPad"
                              Width="180"
                              Height="100"
                              Background="Transparent"
                              Cursor="Hand"
                              MouseLeftButtonDown="OnSvDown"
                              MouseLeftButtonUp="OnSvUp"
                              MouseMove="OnSvMove"
                              SizeChanged="OnPadSizeChanged">
                            <Image x:Name="SvImage"
                                   IsHitTestVisible="False"
                                   Stretch="Fill"/>
                            <Canvas IsHitTestVisible="False">
                                <Ellipse x:Name="SvThumb"
                                         Width="12"
                                         Height="12"
                                         Stroke="White"
                                         StrokeThickness="2">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="2"
                                                          Opacity="0.9"
                                                          ShadowDepth="0"
                                                          Color="Black"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Canvas>
                        </Grid>
                    </Border>

                    <Border BorderBrush="#808080" BorderThickness="1">
                        <Grid x:Name="HueBar"
                              Width="180"
                              Height="14"
                              Background="Transparent"
                              Cursor="Hand"
                              MouseLeftButtonDown="OnHueDown"
                              MouseLeftButtonUp="OnHueUp"
                              MouseMove="OnHueMove"
                              SizeChanged="OnPadSizeChanged">
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#FF0000"/>
                                        <GradientStop Offset="0.17" Color="#FFFF00"/>
                                        <GradientStop Offset="0.33" Color="#00FF00"/>
                                        <GradientStop Offset="0.5" Color="#00FFFF"/>
                                        <GradientStop Offset="0.67" Color="#0000FF"/>
                                        <GradientStop Offset="0.83" Color="#FF00FF"/>
                                        <GradientStop Offset="1" Color="#FF0000"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Canvas IsHitTestVisible="False">
                                <Rectangle x:Name="HueThumb"
                                           Width="4"
                                           Height="14"
                                           Fill="White"
                                           Stroke="Black"
                                           StrokeThickness="1"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <Border Margin="0,8,0,0"
                            BorderBrush="#808080"
                            BorderThickness="1"
                            ToolTip="Opacity">
                        <Grid x:Name="AlphaBar"
                              Width="180"
                              Height="14"
                              Background="Transparent"
                              Cursor="Hand"
                              MouseLeftButtonDown="OnAlphaDown"
                              MouseLeftButtonUp="OnAlphaUp"
                              MouseMove="OnAlphaMove"
                              SizeChanged="OnPadSizeChanged">
                            <Rectangle Fill="{StaticResource CheckerBrush}" IsHitTestVisible="False"/>
                            <Rectangle IsHitTestVisible="False">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="AlphaStart" Offset="0" Color="#00000000"/>
                                        <GradientStop x:Name="AlphaEnd" Offset="1" Color="#FF000000"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Canvas IsHitTestVisible="False">
                                <Rectangle x:Name="AlphaThumb"
                                           Width="4"
                                           Height="14"
                                           Fill="White"
                                           Stroke="Black"
                                           StrokeThickness="1"/>
                            </Canvas>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
