<prism:PrismApplication x:Class="Lyrixound.App"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:converters="clr-namespace:Lyrixound.Converters"
                        xmlns:local="clr-namespace:Lyrixound"
                        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                        xmlns:prism="http://prismlibrary.com/"
                        DispatcherUnhandledException="OnDispatcherUnhandledException">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light"
                                             PrimaryColor="DeepPurple"
                                             SecondaryColor="Lime"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:NameToIconUriConverter x:Key="NameToIconUriConverter"
                                               Extension="png"
                                               IconsDirectory="Icons"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <converters:ByteToOpacityConverter x:Key="ByteToOpacityConverter"/>
            <Style x:Key="FloatingHintTextBox"
                   TargetType="TextBox"
                   BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
                <Setter Property="Margin" Value="0,3,0,6"/>
                <Setter Property="Padding" Value="0,10,0,5"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>

    <JumpList.JumpList>
        <JumpList>
            <JumpTask Title="Lyrixound Website"
                      ApplicationPath="{x:Static local:App.JumpListWebsiteUrl}"
                      Description="Open Lyrixound Website"
                      IconResourceIndex="-1"/>
        </JumpList>
    </JumpList.JumpList>
</prism:PrismApplication>
